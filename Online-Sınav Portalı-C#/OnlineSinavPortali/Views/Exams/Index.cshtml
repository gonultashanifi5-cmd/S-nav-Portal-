@model IReadOnlyList<ExamRow>
@{
    ViewData["Title"] = "Sınavlar";
}
<header class="page-heading">
    <h1>Sınavlar</h1>
    <a class="portal-button primary" asp-action="Form">Sınav ekle</a>
</header>
<div class="surface">
    @if (Model.Count == 0)
    {
        <p class="empty-state">Henüz sınav eklenmedi.</p>
    }
    else
    {
        <partial name="_ExamTable" model="Model" />
    }
</div>
