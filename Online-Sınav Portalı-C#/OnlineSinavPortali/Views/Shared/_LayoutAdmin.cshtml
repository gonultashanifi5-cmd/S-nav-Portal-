@{
    var section = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Online Sınav Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <div class="admin-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Admin" asp-action="Index">
                <span class="brand-mark" aria-hidden="true"></span>
                <span>Online Sınav<br />Portalı</span>
            </a>
            <nav class="navigation" aria-label="Yönetim menüsü">
                <a asp-controller="Admin" asp-action="Index" aria-current="@(section == "Admin" ? "page" : null)">Genel Bakış</a>
                <a asp-controller="Courses" asp-action="Index" aria-current="@(section == "Courses" ? "page" : null)">Dersler</a>
                <a asp-controller="Exams" asp-action="Index" aria-current="@(section == "Exams" ? "page" : null)">Sınavlar</a>
            </nav>
            <div class="session-panel">
                <span class="session-name">@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="sign-out" type="submit">Çıkış yap</button>
                </form>
            </div>
        </aside>
        <main id="main" tabindex="-1" class="admin-main">
            @if (TempData["Success"] is string success)
            {
                <div class="notice" role="status">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="notice notice-error" role="alert">@error</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
