@model IReadOnlyList<CourseRow>
@{
    ViewData["Title"] = "Dersler";
}
<header class="page-heading">
    <h1>Dersler</h1>
    <a class="portal-button primary" asp-action="Form">Ders ekle</a>
</header>
<div class="surface">
    @if (Model.Count == 0)
    {
        <p class="empty-state">Henüz ders eklenmedi. Sınav oluşturmadan önce bir ders ekleyin.</p>
    }
    else
    {
        <table class="portal-table course-table">
            <caption class="visually-hidden">Ders listesi</caption>
            <thead><tr><th scope="col">Ders</th><th scope="col">Sınav sayısı</th><th scope="col">İşlemler</th></tr></thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <th scope="row">@course.Name <span class="row-meta">@course.Code</span></th>
                        <td>@course.ExamCount</td>
                        <td>
                            <div class="row-actions">
                                <a class="text-link" asp-action="Form" asp-route-id="@course.Id" aria-label="@course.Name dersini düzenle">Düzenle</a>
                                @if (course.ExamCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@course.Id" method="post" data-confirm="Bu ders silinsin mi?">
                                        <button class="text-link danger" type="submit" aria-label="@course.Name dersini sil">Sil</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
